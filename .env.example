# Model backend: ollama (local, free), gemini (hosted free tier), or claude (paid API).
# Leave unset to auto-pick: gemini on Render, ollama everywhere else.
LLM_PROVIDER=

# Ollama (local) — install from ollama.com, then: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Gemini (published site) — free tier key from aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# Claude (optional) — key from platform.claude.com, billed per token
ANTHROPIC_API_KEY=
